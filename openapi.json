{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Sirwan Afifi Public Content API",
    "summary": "Read-only metadata and post indexes for sirwan.info.",
    "description": "A public, read-only API for discovering Sirwan Afifi's site and published writing. No authentication or API key is required. The API does not expose write operations, webhooks, or private data.",
    "version": "1.0.0",
    "license": {
      "name": "All rights reserved"
    },
    "contact": {
      "name": "Sirwan Afifi",
      "url": "https://sirwan.info/contact",
      "email": "sir1afifi@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://sirwan.info",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "Sirwan Afifi developer portal, versioning policy, and error guidance",
    "url": "https://sirwan.info/developers"
  },
  "tags": [
    {
      "name": "Discovery",
      "description": "Machine-readable information about the site."
    },
    {
      "name": "Content",
      "description": "Indexes of publicly available writing."
    }
  ],
  "paths": {
    "/api/v1/site.json": {
      "get": {
        "operationId": "getSiteMetadataV1",
        "summary": "Get site metadata and discovery links",
        "description": "Returns Sirwan Afifi's public site identity, language coverage, authentication policy, and canonical discovery-resource URLs.",
        "tags": [
          "Discovery"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Site identity, languages, and public resources.",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the IETF RateLimit structured-field format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "description": "Maximum requests allowed in the current 60-second window.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteMetadata"
                }
              }
            }
          },
          "405": {
            "description": "The endpoint received a method other than GET or HEAD.",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the IETF RateLimit structured-field format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "description": "Maximum requests allowed in the current 60-second window.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "The client exceeded the public API quota.",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the IETF RateLimit structured-field format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "description": "Maximum requests allowed in the current 60-second window.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "Retry-After": {
                "description": "Seconds the client should wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The static content origin is temporarily unavailable.",
            "headers": {
              "RateLimit-Policy": {
                "description": "Public API quota policy in the IETF RateLimit structured-field format.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Limit": {
                "description": "Maximum requests allowed in the current 60-second window.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "Retry-After": {
                "description": "Seconds the client should wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts.json": {
