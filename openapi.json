  "components": {
    "schemas": {
      "SiteMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "description",
          "author",
          "languages",
          "resources",
          "authentication"
        ],
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Sirwan Afifi"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "location"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "en",
                "fa",
                "ku"
              ]
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "developers",
              "documentation",
              "openapi",
              "llms",
              "siteApi",
              "postsApi",
              "rss",
              "sitemap",
              "contact",
              "privacy"
            ],
            "properties": {
              "developers": {
                "type": "string",
                "format": "uri"
              },
              "documentation": {
                "type": "string",
                "format": "uri"
              },
              "openapi": {
                "type": "string",
                "format": "uri"
              },
              "llms": {
                "type": "string",
                "format": "uri"
              },
              "siteApi": {
                "type": "string",
                "format": "uri"
              },
              "postsApi": {
                "type": "string",
                "format": "uri"
              },
              "rss": {
                "type": "string",
                "format": "uri"
              },
              "sitemap": {
                "type": "string",
                "format": "uri"
              },
              "contact": {
                "type": "string",
                "format": "uri"
              },
              "privacy": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "authentication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "apiKeysIssued"
            ],
            "properties": {
              "required": {
                "type": "boolean",
                "const": false
              },
              "apiKeysIssued": {
                "type": "boolean",
                "const": false
              }
            }
          }
        }
      },
      "PostSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "slug",
          "language",
          "published",
          "updated",
          "tags",
          "url",
          "markdownUrl"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fa",
              "ku"
            ]
          },
          "published": {
            "type": "string",
            "format": "date"
          },
          "updated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdownUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "PostIndex": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "posts"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostSummary"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "resolution"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "enum": [
              "method_not_allowed",
              "rate_limit_exceeded",
              "api_route_not_found",
              "upstream_unavailable"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "documentation_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "x-rate-limit-policy": {
    "name": "public-api",
    "quota": 600,
    "window_seconds": 60,
    "partition": "Anonymous network address and endpoint within a Cloudflare location"
  },
  "x-api-lifecycle": {
    "current_major_version": "v1",
    "deprecation_policy_url": "https://sirwan.info/docs#versioning-and-deprecation"
  }
}